# Worker requires a direct/session PostgreSQL connection. For Neon, do NOT use a hostname containing -pooler.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/emerald?sslmode=verify-full
ENCRYPTION_KEY=
BOT_TOKEN=
SITE_URL=https://YOUR-SITE.vercel.app
# Mandatory explicit opt-in: trusted users only; subprocesses are NOT a sandbox.
TRUSTED_CODE_ONLY=true
DATA_DIR=/app/data/emerald
MAX_RUNNING_BOTS=10
INSTALL_TIMEOUT=600
MAX_WORKDIR_MB=1024

# Optional: a separate Docker daemon. Leave unset for regular Bothost process hosting.
# DOCKER_HOST=tcp://docker.example.com:2376
# DOCKER_TLS_VERIFY=1
# DOCKER_CERT_PATH=/path/to/client/certificates
# DOCKER_NAMESPACE=emerald-host
# DOCKER_BOT_MEMORY=256m
