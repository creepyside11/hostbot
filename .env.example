DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/emerald?sslmode=verify-full
ENCRYPTION_KEY=
BOT_TOKEN=
SITE_URL=https://YOUR-SITE.vercel.app
# Mandatory explicit opt-in: trusted users only; subprocesses are NOT a sandbox.
TRUSTED_CODE_ONLY=true
DATA_DIR=/app/data/emerald
MAX_RUNNING_BOTS=10
INSTALL_TIMEOUT=600
MAX_WORKDIR_MB=1024
